{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowOnlySpecificBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::p1-s3b",
        "arn:aws:s3:::p1-s3b/*"
      ]
    },
    {
      "Sid": "DenyAccessToOtherBuckets",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "NotResource": [
        "arn:aws:s3:::p1-s3b",
        "arn:aws:s3:::p1-s3b/*"
      ]
    }
  ]
}
